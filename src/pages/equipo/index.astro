---
import Layout from '../../components/Layout.astro';
import equipo from '../../data/equipo.json';
---

<Layout title="Nuestro equipo" description="Conoce al equipo de Espacio Arroelo: la Arroeloverfamily.">
	<article class="content">
		<h1 class="page-title">Nuestro equipo</h1>

		<p>La Arroeloverfamily: personas que hacen posible el día a día de Espacio Arroelo.</p>

		<ul class="team-grid">
			{equipo.map((persona) => (
				<li>
					<a href={`/equipo/${persona.slug}`} class="team-card">
						<img
							class="team-photo"
							src={persona.photo ? `/equipo/${persona.photo}` : '/equipo/placeholder.svg'}
							alt=""
							width="200"
							height="200"
							loading="lazy"
						/>
						<span class="team-name">{persona.name}</span>
					</a>
				</li>
			))}
		</ul>
	</article>
</Layout>

<style>
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: var(--space-lg);
		list-style: none;
		padding: 0;
		margin: var(--space-xl) 0 0;
	}
	.team-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-md);
		padding: var(--space-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.team-card:hover {
		border-color: var(--color-accent-light);
		box-shadow: 0 4px 12px rgba(45, 106, 79, 0.12);
	}
	.team-photo {
		width: 200px;
		height: 200px;
		object-fit: cover;
		border-radius: 50%;
		background: var(--color-accent-soft);
		filter: grayscale(100%);
	}
	.team-name {
		font-weight: 700;
		color: var(--color-accent);
		font-size: 1.05rem;
		text-align: center;
	}
</style>
